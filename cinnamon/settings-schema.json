{
  "header-check": {
    "type": "header",
    "description": "Connectivity check"
  },
  "host": {
    "type": "entry",
    "default": "8.8.8.8",
    "description": "Host",
    "tooltip": "Hostname or IP address periodically pinged to determine connectivity. Falls back to 8.8.8.8 if empty."
  },
  "interval": {
    "type": "spinbutton",
    "default": 5,
    "min": 2,
    "max": 300,
    "step": 1,
    "units": "seconds",
    "description": "Interval",
    "tooltip": "Seconds between connectivity checks."
  },
  "loss-threshold": {
    "type": "spinbutton",
    "default": 50,
    "min": 1,
    "max": 100,
    "step": 1,
    "units": "%",
    "description": "Loss threshold",
    "tooltip": "Packet loss percentage, from the latest check, at or above which the indicator turns red."
  }
}
